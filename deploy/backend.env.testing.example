# TESTING on prime.adpedia.in (single domain, path-based).
# Copy to backend/.env on the test server.
NODE_ENV=production
PORT=5000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/prime_promenade?schema=public&sslmode=require"

# Same-origin, but keep it explicit
CORS_ORIGINS=https://prime.adpedia.in

JWT_ACCESS_SECRET=CHANGE_ME_32_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_32_BYTES
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SEED_ADMIN_NAME=Prime Admin
SEED_ADMIN_EMAIL=admin@primepromenade.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG

# OTP console mode for testing (no SMS provider yet)
OTP_PROVIDER=console
OTP_DEV_RETURN=false
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# The API is reached at /backend behind Nginx, so uploaded-file URLs must
# include that prefix.
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=https://prime.adpedia.in/backend

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
