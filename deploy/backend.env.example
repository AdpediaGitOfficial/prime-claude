# Copy to backend/.env on the server and fill in real values.
NODE_ENV=production
PORT=5000

# Managed PostgreSQL connection string (Neon / Supabase / RDS / DO)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/prime_promenade?schema=public&sslmode=require"

# Allowed browser origins (the real domains — no trailing slash)
CORS_ORIGINS=https://primepromenade.com,https://www.primepromenade.com,https://admin.primepromenade.com

# Generate fresh: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_32_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_32_BYTES
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed admin — set, then CHANGE the password after first login
SEED_ADMIN_NAME=Prime Admin
SEED_ADMIN_EMAIL=admin@primepromenade.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG

# OTP — console mode for now (decide SMS provider later).
# Pool-booking OTP won't be delivered by SMS until a provider is wired.
OTP_PROVIDER=console
OTP_DEV_RETURN=false
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# File storage — MUST point at a persistent volume/path that survives redeploys
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=https://api.primepromenade.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
