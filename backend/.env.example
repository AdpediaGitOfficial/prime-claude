# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed CORS origins (the frontend URLs)
CORS_ORIGINS=http://localhost:3000,https://primepromenade.com,https://prime.adpedia.in

# ─── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prime_promenade?schema=public"

# ─── Auth (JWT) ───────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Seed admin (created by prisma/seed.ts) ───────────────
SEED_ADMIN_NAME=Prime Admin
SEED_ADMIN_EMAIL=admin@primepromenade.com
SEED_ADMIN_PASSWORD=Admin@12345

# ─── OTP ──────────────────────────────────────────────────
# Provider: "console" (dev, logs OTP) | "msg91" | "twilio"
OTP_PROVIDER=console
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
# In non-production, expose the OTP in the send-otp response for testing.
OTP_DEV_RETURN=true
# MSG91 (only if OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
# Twilio (only if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── File storage (local) ─────────────────────────────────
UPLOAD_DIR=uploads
# Public base URL used to build absolute file links in API responses
PUBLIC_BASE_URL=http://localhost:5000

# ─── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
